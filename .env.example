# Copy this file to .env and fill in the values.
# .env holds secrets and must never be committed to Git.

# ---------- Database (PostgreSQL) ----------
DB_NAME=jobtrack_db
DB_USER=jobtracker_user
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=5432

# ---------- Google OAuth (Gmail integration) ----------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match an "Authorized redirect URI" in Google Cloud exactly.
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/gmail/callback/

# ---------- Django ----------
# Local development: leave these out (DEBUG is on, a development key is used).
# Docker / production: both are required.
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=

# ---------- Docker (docker compose up) ----------
# Secret key used only by the Docker containers.
DOCKER_DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com
# FRONTEND_URL=https://example.com
# USE_HTTPS=True

# Optional: a dedicated key for encrypting stored Gmail tokens.
# If empty, one is derived from the Django secret key.
# Changing either key means users must connect Gmail again.
# Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TOKEN_ENCRYPTION_KEY=
